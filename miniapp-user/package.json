{
  "name": "miniapp-user",
  "version": "1.0.0",
  "description": "搬家服务用户微信小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:weapp": "taro build --type weapp",
    "dev:h5": "npm run build:h5 -- --watch",
    "build:h5": "taro build --type h5"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@tarojs/components": "3.6.22",
    "@tarojs/plugin-framework-react": "3.6.22",
    "@tarojs/plugin-platform-weapp": "3.6.22",
    "@tarojs/react": "3.6.22",
    "@tarojs/runtime": "3.6.22",
    "@tarojs/taro": "3.6.22",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-react": "^7.18.0",
    "@tarojs/cli": "3.6.22",
    "@tarojs/webpack5-runner": "3.6.22",
    "@types/react": "^18.2.0",
    "babel-preset-taro": "3.6.22",
    "postcss": "^8.4.0",
    "sass": "^1.62.0",
    "typescript": "^5.1.0",
    "webpack": "5.88.0"
  }
}
